  @@unique([actor_uri, remote_status_id], map: "sqlite_autoindex_remote_boosts_4")
  @@index([actor_uri, id], map: "idx_remote_boosts_actor_id")
  @@index([local_status_id], map: "idx_remote_boosts_local_status")
  @@index([remote_status_id], map: "idx_remote_boosts_remote_status")
}

