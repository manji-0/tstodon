generator client {
  provider        = "prisma-client"
  output          = "../packages/worker/server/generated/prisma"
  runtime         = "cloudflare"
  previewFeatures = ["typedSql", "partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

model account_list_members {
  list_id           String
  member_account_id String
  created_at        String
  accounts          accounts      @relation(fields: [member_account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account_lists     account_lists @relation(fields: [list_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([list_id, member_account_id])
  @@index([member_account_id, list_id], map: "idx_account_list_members_member")
}

model account_lists {
  id                          String                        @id
  account_id                  String
  title                       String
  replies_policy              String                        @default("list")
  exclusive                   Int                           @default(0)
  created_at                  String
  updated_at                  String
  account_list_members        account_list_members[]
  account_list_remote_members account_list_remote_members[]
  accounts                    accounts                      @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id, created_at(sort: Desc)], map: "idx_account_lists_owner")
}

model account_list_remote_members {
  list_id            String
  outbound_follow_id String
  created_at         String
  outbound_follows   outbound_follows @relation(fields: [outbound_follow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account_lists      account_lists    @relation(fields: [list_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([list_id, outbound_follow_id])
  @@index([outbound_follow_id, list_id], map: "idx_account_list_remote_members_follow")
}

model endorsements {
  id                 String? @unique
  account_id        String
  target_account_id String?
  target_actor_uri  String
  created_at        String  @default("CURRENT_TIMESTAMP")

  @@id([account_id, target_actor_uri])
  @@index([account_id, created_at(sort: Desc)], map: "idx_endorsements_owner_created")
  @@index([target_account_id], map: "idx_endorsements_target_account_id")
}

model account_notes {
  account_id        String
  target_account_id String?
  target_actor_uri  String
  note              String  @default("")
  created_at        String  @default("CURRENT_TIMESTAMP")
  updated_at        String  @default("CURRENT_TIMESTAMP")

  @@id([account_id, target_actor_uri])
  @@index([target_account_id], map: "idx_account_notes_target_account_id")
}

model announcements {
  id           String  @id
  content      String
  starts_at    String?
  ends_at      String?
  all_day      Int     @default(0)
  published_at String?
  created_at   String  @default("CURRENT_TIMESTAMP")
  updated_at   String  @default("CURRENT_TIMESTAMP")

  @@index([published_at(sort: Desc), id(sort: Desc)], map: "idx_announcements_published")
}

model account_moderation {
  account_id String @id
  moderation String
  created_at String @default("CURRENT_TIMESTAMP")
  updated_at String @default("CURRENT_TIMESTAMP")

  @@index([moderation, account_id], map: "idx_account_moderation_state")
}

model remote_actor_moderation {
  actor_uri  String  @id
  moderation String?
  sensitized Int     @default(0)
  created_at String  @default("CURRENT_TIMESTAMP")
  updated_at String  @default("CURRENT_TIMESTAMP")

  @@index([moderation, actor_uri], map: "idx_remote_actor_moderation_state")
}

model account_domain_blocks {
  account_id String
  domain     String
  created_at String @default("CURRENT_TIMESTAMP")

  @@id([account_id, domain])
  @@index([account_id, created_at(sort: Desc)], map: "idx_account_domain_blocks_account_created")
}

model push_subscriptions {
  id          Int    @id @default(autoincrement())
  account_id  String
  endpoint    String
  p256dh      String
  auth        String
  standard    Int    @default(0)
  alerts_json String @default("{}")
  policy      String @default("all")
  created_at  String @default("CURRENT_TIMESTAMP")
  updated_at  String @default("CURRENT_TIMESTAMP")

  @@unique([account_id, endpoint])
  @@index([account_id, updated_at(sort: Desc), id(sort: Desc)], map: "idx_push_subscriptions_account_updated")
}

model status_idempotency {
  account_id      String
  idempotency_key String
  status_id       String @default("")
  created_at      String @default("CURRENT_TIMESTAMP")
  kind            String @default("Status")

  @@id([account_id, idempotency_key])
  @@index([account_id, created_at], map: "idx_status_idempotency_created")
}

model notification_policies {
  account_id           String @id
  for_not_following    String @default("accept")
  for_not_followers    String @default("accept")
  for_new_accounts     String @default("accept")
  for_private_mentions String @default("drop")
  for_limited_accounts String @default("filter")
  for_bots             String @default("accept")
  updated_at           String @default("CURRENT_TIMESTAMP")
}

model notification_requests {
  notification_id String @id
  account_id      String
  from_account_id String
  status_id       String?
  created_at      String @default("CURRENT_TIMESTAMP")

  @@index([account_id, from_account_id], map: "idx_notification_requests_account")
}

model notification_request_acceptances {
  account_id      String
  from_account_id String
  accepted_at     String @default("CURRENT_TIMESTAMP")

  @@id([account_id, from_account_id])
}

model account_profiles {
  account_id          String  @id
  note                String  @default("")
  fields_json         String  @default("[]")
  bot                 Int     @default(0)
  discoverable        Int     @default(1)
  avatar_object_key   String?
  avatar_content_type String?
  header_object_key   String?
  header_content_type String?
  updated_at          String  @default("CURRENT_TIMESTAMP")
  avatar_metadata_stripped_at String?
  avatar_metadata_strip_error String?
  header_metadata_stripped_at String?
  header_metadata_strip_error String?
}

model account_flags {
  account_id String @id
  sensitized Int    @default(0)
  pending    Int    @default(0)
  disabled   Int    @default(0)
  created_at String @default("CURRENT_TIMESTAMP")
  updated_at String @default("CURRENT_TIMESTAMP")
}

model domain_blocks {  id              String  @id
  domain          String  @unique
  severity        String
  reject_media    Int     @default(0)
  reject_reports  Int     @default(0)
  obfuscate       Int     @default(0)
  private_comment String?
  public_comment  String?
  created_at      String  @default("CURRENT_TIMESTAMP")
  updated_at      String  @default("CURRENT_TIMESTAMP")

  @@index([severity, domain], map: "idx_domain_blocks_severity")
}

model accounts {
  id                                                    String @id
  username                                              String                 @unique(map: "sqlite_autoindex_accounts_2")
  access_email                                          String                 @unique(map: "sqlite_autoindex_accounts_3")
  display_name                                          String
  locked                                                Int                    @default(0)
  default_post_visibility                               String                 @default("public")
  default_quote_policy                                  String                 @default("public")
  public_key_pem                                        String
  private_key_jwk                                       String
  created_at                                            String                 @default("CURRENT_TIMESTAMP")
  updated_at                                            String                 @default("CURRENT_TIMESTAMP")
  bio_text                                              String                 @default("")
  avatar_object_key                                     String?
  header_object_key                                     String?
  account_list_members                                  account_list_members[]
  account_lists                                         account_lists[]       
  bookmarks                                             bookmarks[]
  conversation_hides                                    conversation_hides[]
  conversation_reads                                    conversation_reads[]
  favourites                                            favourites[]
  filters                                               filters[]             
  follows_follows_target_account_idToaccounts           follows[]              @relation("follows_target_account_idToaccounts")
  follows_follows_follower_account_idToaccounts         follows[]              @relation("follows_follower_account_idToaccounts")
  markers                                               markers[]
  media_attachments                                     media_attachments[]
  notifications_notifications_account_idToaccounts      notifications[]        @relation("notifications_account_idToaccounts")
  outbound_activities                                   outbound_activities[] 
  poll_votes                                            poll_votes[]
  remote_follows                                        remote_follows[]
  reports_reports_target_account_idToaccounts           reports[]              @relation("reports_target_account_idToaccounts")
  reports_reports_account_idToaccounts                  reports[]              @relation("reports_account_idToaccounts")
  notification_request_groups                            notification_request_groups[]
  scheduled_statuses                                          scheduled_statuses[]
  statuses_cleanup_policies                                   statuses_cleanup_policies?
  status_mentions                                       status_mentions[]
  remote_status_mentions                                remote_status_mentions[]
  remote_poll_own_votes                                 remote_poll_own_votes[]
  outbound_follows                                      outbound_follows[]
  statuses                                              statuses[]
}

model bookmarks {
  id               String           @id
  account_id       String
  local_status_id  String?
  remote_status_id String?
  created_at       String           @default("CURRENT_TIMESTAMP")
  statuses         statuses?        @relation(fields: [local_status_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  remote_statuses  remote_statuses? @relation(fields: [remote_status_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accounts         accounts         @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([account_id, local_status_id])
  @@unique([account_id, remote_status_id])
  @@index([local_status_id], map: "idx_bookmarks_status")
  @@index([remote_status_id], map: "idx_bookmarks_remote_status")
}

model conversation_hides {
  account_id      String
  conversation_id String
  hidden_status_id String
  created_at      String @default("CURRENT_TIMESTAMP")
  accounts        accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([account_id, conversation_id])
}

model conversation_reads {
  account_id          String
  conversation_id     String
  last_read_status_id String
  updated_at          String
  accounts            accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([account_id, conversation_id])
}

model favourites {
  id               String           @id
  account_id       String
  local_status_id  String?
  remote_status_id String?
  created_at       String           @default("CURRENT_TIMESTAMP")
  statuses         statuses?        @relation(fields: [local_status_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  remote_statuses  remote_statuses? @relation(fields: [remote_status_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accounts         accounts         @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([account_id, local_status_id])
  @@unique([account_id, remote_status_id])
  @@index([local_status_id, id], map: "idx_favourites_status")
  @@index([remote_status_id, id], map: "idx_favourites_remote_status")
}

model filter_statuses {
  id         String? @unique(map: "idx_filter_statuses_id")
  filter_id  String
  status_id  String
  created_at String  @default("CURRENT_TIMESTAMP")

  @@id([filter_id, status_id])
}

model filters {
  id            String @id
  account_id    String
  phrase        String
  context_json  String
  whole_word    Int      @default(0)
  irreversible  Int      @default(0)
  expires_at    String?
  keywords_json String   @default("[]")
  created_at    String   @default("CURRENT_TIMESTAMP")
  accounts     accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model follows {
  id                                             String @id
  follower_account_id                            String
  target_account_id                              String
  kind                                           String
  reblogs                                        Int      @default(1)
  notify                                         Int      @default(0)
  languages_json                                 String   @default("[]")
  created_at                                     String   @default("CURRENT_TIMESTAMP")
  accounts_follows_target_account_idToaccounts   accounts @relation("follows_target_account_idToaccounts", fields: [target_account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accounts_follows_follower_account_idToaccounts accounts @relation("follows_follower_account_idToaccounts", fields: [follower_account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([follower_account_id, target_account_id], map: "sqlite_autoindex_follows_2")
  @@index([target_account_id, kind], map: "idx_follows_target")
}

model blocks {
  id                 String? @unique
  blocker_account_id String
  target_account_id  String?
  target_actor_uri   String
  created_at         String  @default("CURRENT_TIMESTAMP")

  @@id([blocker_account_id, target_actor_uri])
  @@index([target_account_id], map: "idx_blocks_target_account_id")
}

model remote_blocks {
  actor_uri  String
  account_id String
  created_at String

  @@id([actor_uri, account_id])
  @@index([account_id, actor_uri], map: "idx_remote_blocks_account")
}

model mutes {
  id                 String? @unique
  account_id        String
  target_account_id String?
  target_actor_uri  String
  notifications     Int     @default(1)
  expires_at        String?
  created_at        String  @default("CURRENT_TIMESTAMP")

  @@id([account_id, target_actor_uri])
  @@index([target_account_id], map: "idx_mutes_target_account_id")
  @@index([account_id, created_at(sort: Desc)], map: "idx_mutes_account_created_at")
}

model notification_dismissals {
  account_id      String
  notification_id String
  created_at      String @default("CURRENT_TIMESTAMP")

  @@id([account_id, notification_id])
}

model notification_clear_markers {
  account_id String @id
  cleared_at String
}

model status_edits {
  id            String @id
  status_id     String
  snapshot_json String
  created_at    String @default("CURRENT_TIMESTAMP")

  @@index([status_id, created_at(sort: Desc), id(sort: Desc)], map: "idx_status_edits_status_created")
}

model remote_status_edits {
  id            String @id
  status_id     String
  snapshot_json String
  created_at    String @default("CURRENT_TIMESTAMP")
  remote_statuses remote_statuses @relation(fields: [status_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status_id, created_at(sort: Desc), id(sort: Desc)], map: "idx_remote_status_edits_status_created")
}

model status_pins {
  account_id String
  status_id  String
  created_at String @default("CURRENT_TIMESTAMP")

  @@id([account_id, status_id])
  @@index([account_id, created_at(sort: Desc)], map: "idx_status_pins_account_created")
}

model account_announcement_dismissals {
  account_id      String
  announcement_id String
  created_at      String @default("CURRENT_TIMESTAMP")
  updated_at      String @default("CURRENT_TIMESTAMP")

  @@id([account_id, announcement_id])
}

model account_announcement_reactions {
  account_id      String
  announcement_id String
  reaction_name   String
  created_at      String @default("CURRENT_TIMESTAMP")
  updated_at      String @default("CURRENT_TIMESTAMP")

  @@id([account_id, announcement_id, reaction_name])
  @@index([announcement_id, reaction_name], map: "idx_announcement_reactions_group")
}

model status_mutes {
  account_id            String
  thread_root_status_id String
  created_at            String @default("CURRENT_TIMESTAMP")

  @@id([account_id, thread_root_status_id])
}

model followed_tags {
  account_id String
  tag_name   String
  created_at String @default("CURRENT_TIMESTAMP")

  @@id([account_id, tag_name])
  @@index([account_id, created_at(sort: Desc)], map: "idx_followed_tags_account_created")
}

model featured_tags {
  account_id String
  tag_name   String
  created_at String @default("CURRENT_TIMESTAMP")

  @@id([account_id, tag_name])
  @@index([account_id, created_at(sort: Desc)], map: "idx_featured_tags_account_created")
}

model tags {
  name       String @id
  created_at String @default("CURRENT_TIMESTAMP")
}

model backfill_cursors {
  name         String  @id
  after_id     String  @default("")
  completed_at String?
}

model custom_emojis {
  id                String  @id
  shortcode         String  @unique
  object_key        String  @unique
  content_type      String
  visible_in_picker Int     @default(1)
  category          String?
  created_at        String  @default("CURRENT_TIMESTAMP")
  updated_at        String  @default("CURRENT_TIMESTAMP")

  @@index([shortcode], map: "idx_custom_emojis_shortcode")
}

model inbox_activities {
  activity_id  String @id
  kind         String
  payload_json String
  created_at   String  @default("CURRENT_TIMESTAMP")
}

model instance_settings {
  id          Int    @id @default(autoincrement())
  domain      String
  title       String
  description String
  updated_at  String @default("CURRENT_TIMESTAMP")
}

model markers {
  account_id   String
  timeline     String
  last_read_id String
  version      Int      @default(0)
  updated_at   String
  accounts     accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([account_id, timeline])
}

model media_attachments {
  id           String @id
  account_id   String
  status_id    String?
  object_key   String    @unique(map: "sqlite_autoindex_media_attachments_2")
  content_type String
  created_at   String    @default("CURRENT_TIMESTAMP")
  description  String?
  focus_x      Float?
  focus_y      Float?
  legacy_object_key String?
  position     Int?
  width        Int?
  height       Int?
  preview_object_key String?
  preview_width Int?
  preview_height Int?
  blurhash     String?
  metadata_stripped_at String?
  metadata_strip_error String?
  statuses     statuses? @relation(fields: [status_id], references: [id], onUpdate: NoAction)
  accounts     accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notifications {
  id                                               String @id
  account_id                                       String
  from_account_id                                  String
  from_actor_uri                                   String?
  kind                                             String
  status_id                                        String?
  target_account_id                                String?
  report_id                                        String?
  severance_event_id                               String?
  created_at                                       String   @default("CURRENT_TIMESTAMP")
  accounts_notifications_account_idToaccounts      accounts @relation("notifications_account_idToaccounts", fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id, created_at(sort: Desc)], map: "idx_notifications_account_created_at")
  @@index([account_id, from_account_id], map: "idx_notifications_account_from")
  @@index([account_id, from_actor_uri], map: "idx_notifications_account_actor")
}

model outbound_activities {
  id           String    @id
  account_id   String?
  kind         String
  payload_json String
  created_at   String    @default("CURRENT_TIMESTAMP")
  accounts     accounts? @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id, id], map: "idx_outbound_activities_account")
}

model instance_actor_keys {
  id              Int    @id
  public_key_pem  String
  private_key_jwk String
  created_at      String
}

model outbox_deliveries {
  id            String @id
  activity_id   String
  kind          String
  reason_kind   String?
  attempt_count Int     @default(0)
  http_status   Int?
  created_at    String  @default("CURRENT_TIMESTAMP")
  updated_at    String  @default("CURRENT_TIMESTAMP")
  inbox_url     String?

  @@unique([activity_id, inbox_url], map: "idx_outbox_deliveries_target", where: raw("inbox_url IS NOT NULL"))
}

model poll_votes {
  poll_id            String
  account_id         String
  option_index       Int
  created_at         String   @default("CURRENT_TIMESTAMP")
  expiry_notified_at String?
  accounts           accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  polls              polls    @relation(fields: [poll_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([poll_id, account_id, option_index])
  @@index([poll_id], map: "idx_poll_votes_expiry_pending", where: raw("expiry_notified_at IS NULL"))
}

model remote_poll_votes {
  poll_id      String
  actor_uri    String
  option_index Int
  object_uri   String
  created_at   String @default("CURRENT_TIMESTAMP")
  polls        polls  @relation(fields: [poll_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([poll_id, actor_uri, option_index])
}

model polls {
  id                 String @id
  status_id          String       @unique(map: "sqlite_autoindex_polls_2")
  multiple           Int          @default(0)
  expires_at         String
  options_json       String
  expiry_notified_at String?
  update_queued_at   String?
  poll_votes        poll_votes[]
  remote_poll_votes  remote_poll_votes[]
  statuses          statuses     @relation(fields: [status_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_polls_expires_at", where: raw("expiry_notified_at IS NULL"))
}

model remote_actors {
  actor_uri         String @id
  username          String
  domain            String
  inbox_uri         String
  shared_inbox_uri  String?
  public_key_id     String              @unique(map: "sqlite_autoindex_remote_actors_2")
  public_key_pem    String
  display_name      String              @default("")
  moved_to          String?
  fetched_at        String
  created_at        String              @default("CURRENT_TIMESTAMP")
  updated_at        String              @default("CURRENT_TIMESTAMP")
  remote_announces  remote_announces[]
  remote_favourites remote_favourites[]
  remote_follows    remote_follows[]
  remote_statuses   remote_statuses[]
  outbound_follows  outbound_follows[]
  remote_boosts     remote_boosts[]

  @@index([domain, username], map: "idx_remote_actors_domain_username")
  status_remote_mentions status_remote_mentions[]
}

model remote_announces {
  id               String?       @unique
  remote_actor_uri String
  status_id        String
  activity_id      String
  created_at       String        @default("CURRENT_TIMESTAMP")
  statuses         statuses      @relation(fields: [status_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  remote_actors    remote_actors @relation(fields: [remote_actor_uri], references: [actor_uri], onDelete: Cascade, onUpdate: NoAction)

  @@id([remote_actor_uri, status_id])
  @@index([status_id], map: "idx_remote_announces_status")
}

model remote_favourites {
  id                String? @unique
  remote_actor_uri String
  status_id        String
  created_at       String        @default("CURRENT_TIMESTAMP")
  statuses         statuses      @relation(fields: [status_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  remote_actors    remote_actors @relation(fields: [remote_actor_uri], references: [actor_uri], onDelete: Cascade, onUpdate: NoAction)

  @@id([remote_actor_uri, status_id])
  @@index([status_id], map: "idx_remote_favourites_status")
}

model remote_follows {
  id                  String  @id
  remote_actor_uri    String
  target_account_id   String
  remote_request_kind String
  follow_kind         String
  follow_activity_id  String?
  created_at          String  @default("CURRENT_TIMESTAMP")
  accounts            accounts      @relation(fields: [target_account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  remote_actors       remote_actors @relation(fields: [remote_actor_uri], references: [actor_uri], onDelete: Cascade, onUpdate: NoAction)

  @@unique([remote_actor_uri, target_account_id], map: "sqlite_autoindex_remote_follows_2")
  @@index([target_account_id, follow_kind], map: "idx_remote_follows_target")
  @@index([target_account_id, remote_request_kind], map: "idx_remote_follows_pending")
}

model remote_status_tags {
  status_id     String
  tag           String
  remote_statuses remote_statuses @relation(fields: [status_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([status_id, tag])
  @@index([tag, status_id], map: "idx_remote_status_tags_tag")
}

model remote_statuses {
  id            String @id
  actor_uri     String
  object_uri    String        @unique(map: "sqlite_autoindex_remote_statuses_2")
  url           String?
  content_html  String
  spoiler_text  String        @default("")
  visibility    String
  sensitive     Int           @default(0)
  language      String?
  published_at  String
  media_json    String        @default("[]")
  tags_indexed  Int           @default(0)
  card_json     String?
  card_url      String?
  in_reply_to_uri String?
  edited_at     String?
  poll_json     String?
  emojis_json   String        @default("[]")
  created_at    String        @default("CURRENT_TIMESTAMP")
  updated_at    String        @default("CURRENT_TIMESTAMP")
  quote_policy_json String?
  remote_actors remote_actors @relation(fields: [actor_uri], references: [actor_uri], onDelete: Cascade, onUpdate: NoAction)
  remote_status_tags remote_status_tags[]
  remote_status_mentions remote_status_mentions[]
  remote_status_remote_mentions remote_status_remote_mentions[]
  remote_poll_own_votes remote_poll_own_votes[]
  remote_boosts remote_boosts[]
  remote_status_edits remote_status_edits[]

  favourites    favourites[]
  bookmarks     bookmarks[]
  statuses      statuses[]
  status_quotes status_quotes?

  @@index([actor_uri, published_at(sort: Desc)], map: "idx_remote_statuses_actor_published")
  @@index([visibility, published_at(sort: Desc)], map: "idx_remote_statuses_visibility_published")
  @@index([card_url, id], map: "idx_remote_statuses_card_url")
  @@index([in_reply_to_uri], map: "idx_remote_statuses_in_reply_to_uri")
}

