# Local-only secrets / overrides. Copy to `.dev.vars` and never commit that file.
#
# Production auth is Cloudflare Access (WorkOS as the Access IdP). Worker vars:
#   CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD, CF_ACCESS_ADMIN_GROUPS
# Pin the public JWKS here when you do not want the Worker to fetch it.
# The private key is not a Worker var. Tests sign with
# packages/worker/test/access-jwt-fixture.ts.
# CF_ACCESS_JWKS_JSON=
# CF_ACCESS_JWKS_URL=
# RESEND_API_KEY=
# VAPID_PRIVATE_JWK=   # P-256 private JWK for Web Push (see docs/reference/configuration.md#web-push)
# VAPID_SUBJECT=mailto:admin@example.com
#
# Extra browser origins for /api/* CORS (comma-separated). INSTANCE_PUBLIC_ORIGIN is always allowed.
# CORS_ALLOWED_ORIGINS=https://web.example.com
