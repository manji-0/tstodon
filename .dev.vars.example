# Local-only secrets / overrides. Copy to `.dev.vars` and never commit that file.
#
# Production auth is Cloudflare Access (WorkOS as the Access IdP). Worker vars:
#   CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD, CF_ACCESS_ADMIN_GROUPS
# Local tests use the fixture JWKS/private JWK from wrangler.jsonc.
# Optionally override:
# CF_ACCESS_JWKS_JSON=
# CF_ACCESS_LOCAL_PRIVATE_JWK=
# RESEND_API_KEY=
#
# Optional instance catalogs (also settable in wrangler.jsonc vars):
# INSTANCE_RULES=[{"id":"1","text":"Be excellent to each other"}]
# INSTANCE_CUSTOM_EMOJIS=[{"shortcode":"wave","url":"https://media.example.com/wave.png"}]
# INSTANCE_ANNOUNCEMENTS=[{"id":"welcome","content":"Hello","published_at":"2026-09-22T12:00:00.000Z"}]
