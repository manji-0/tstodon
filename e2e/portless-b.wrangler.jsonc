// e2e instance tstodon-e2e-b behind portless — https://b.tstodon.localhost (app port 8792).
// Same D1, KV, and R2 ids as e2e/b.wrangler.jsonc. Start it with TSTODON_PERSIST_TO=.wrangler/e2e-b
// so e2e/lib.ts, which reads that persist dir through e2e/b.wrangler.jsonc, sees this state.
// BETTER_AUTH_SECRET stays in the environment. See docs/getting-started/e2e-federation-portless.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tstodon-e2e-b",
  "main": "../packages/worker/server/entry-classes.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "region": "aws:ap-southeast-1",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "assets": {
    "directory": "../packages/worker/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "vars": {
    "INSTANCE_DOMAIN": "b.tstodon.localhost",
    "INSTANCE_PUBLIC_ORIGIN": "https://b.tstodon.localhost",
    "FEDERATION_ALLOW_HOSTS": "a.tstodon.localhost,b.tstodon.localhost",
    "INSTANCE_NAME": "tstodon-e2e-b",
    "INSTANCE_DESCRIPTION": "Cloudflare Workers + D1 + R2 + Queues based Mastodon-compatible server",
    "SOURCE_URL": "https://github.com/YOUR_ORG/tstodon",
    "INSTANCE_LANGUAGES": "ja,en",
    "CONTACT_EMAIL": "admin@example.com",
    "INSTANCE_THUMBNAIL_URL": "https://b.tstodon.localhost/site/thumbnail.png",
    "MEDIA_PUBLIC_BASE_URL": "https://b.tstodon.localhost",
    "EMAIL_FROM": "tstodon <noreply@example.com>",
    "EMAIL_TRANSPORT": "capture",
    // Public test Access key (packages/worker/test/access-jwt-fixture.ts). Not a secret.
    "CF_ACCESS_TEAM_DOMAIN": "https://tstodon.cloudflareaccess.com",
    "CF_ACCESS_AUD": "tstodon-local-aud",
    "CF_ACCESS_JWKS_JSON": "{\"keys\":[{\"kty\":\"RSA\",\"n\":\"qHE50MFXgxUeSKwP4ChF1TRN7gvR1z4bRcTIc7Jcr6qTrccio5BjeveN7dxj8pP985tYQMVI9sx81vEA7v38KzY0Q9UqEgZzd7VP_TGJEm4fxaP7dZSVQWTvrTxNpqCCPml4rc3nNgABRWniSgwCWR1A7d7mpOTicxXG6PApWAPDuRGdBNq2hnkm2fkFSKKf_oyaXjlRZJMYiMR8pOoCb9xrSUKTzrUjK_AvSmt3CcnJwMqMMVn_ZP7-nRi-OogwkOjW0NyUzIle7KQkMYDhHGRMUnZjj6Qwo0yBzvJXXuBjusHTPYHPlSVnY4k9uxA2SojnCUgrM20tGLsmUofpFw\",\"e\":\"AQAB\",\"kid\":\"tstodon-local-access\",\"alg\":\"RS256\",\"use\":\"sig\"}]}",
    "POLL_UPDATE_DELAY_SECONDS": "5",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tstodon-e2e-b",
      "database_id": "00000000-0000-0000-0000-0000000000b1",
      "migrations_dir": "../packages/worker/app/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tstodon-e2e-b-media",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "REMOTE_DNS_CACHE",
      "id": "000000000000000000000000000000b1",
    },
    {
      "binding": "APP_CACHE",
      "id": "000000000000000000000000000000b2",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "OUTBOX_PROCESS_QUEUE",
        "queue": "tstodon-outbox-process",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STREAM_HUB",
        "class_name": "StreamHub",
      },
    ],
  },
  "workflows": [
    {
      "name": "tstodon-outbox-delivery",
      "binding": "OUTBOX_DELIVERY_WORKFLOW",
      "class_name": "OutboxDeliveryWorkflow",
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "tstodon_e2e_b_metrics",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StreamHub"],
    },
  ],
}
