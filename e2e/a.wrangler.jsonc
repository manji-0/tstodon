// e2e instance tstodon-e2e-a — local origin http://127.0.0.1:8791 (port 8791)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tstodon-e2e-a",
  "main": "../packages/worker/src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "region": "aws:ap-southeast-1",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "assets": {
    "directory": "../assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "triggers": {
    "crons": ["17 * * * *", "17 */6 * * *"],
  },
  "vars": {
    "INSTANCE_DOMAIN": "127.0.0.1:8791",
    "INSTANCE_PUBLIC_ORIGIN": "http://127.0.0.1:8791",
    "FEDERATION_ALLOW_HOSTS": "127.0.0.1",
    "INSTANCE_NAME": "tstodon-e2e-a",
    "INSTANCE_DESCRIPTION": "Cloudflare Workers + D1 + R2 + Queues based Mastodon-compatible server",
    "SOURCE_URL": "https://github.com/YOUR_ORG/tstodon",
    "INSTANCE_LANGUAGES": "ja,en",
    "CONTACT_EMAIL": "admin@example.com",
    "INSTANCE_THUMBNAIL_URL": "http://127.0.0.1:8791/site/thumbnail.png",
    "MEDIA_PUBLIC_BASE_URL": "http://127.0.0.1:8791",
    "EMAIL_FROM": "tstodon <noreply@example.com>",
    "CF_ACCESS_TEAM_DOMAIN": "https://tstodon.cloudflareaccess.com",
    "CF_ACCESS_AUD": "tstodon-local-aud",
    "CF_ACCESS_ADMIN_GROUPS": "tstodon-admins",
    "CF_ACCESS_JWKS_URL": "",
