RAILS_ENV=production
NODE_ENV=production
LOCAL_DOMAIN=mastodon.test
BIND=0.0.0.0
WEB_CONCURRENCY=1
MAX_THREADS=5
DB_HOST=db
DB_USER=postgres
DB_NAME=mastodon
REDIS_HOST=redis
ES_ENABLED=false
SMTP_DELIVERY_METHOD=test
RAILS_LOG_LEVEL=info
# The proxy's address is private; Mastodon refuses private addresses otherwise.
ALLOWED_PRIVATE_ADDRESSES=172.30.47.0/24
# Ruby's OpenSSL trusts only the harness CA: federation stays local.
SSL_CERT_FILE=/certs/ca.crt
