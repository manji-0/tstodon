# Copy to the shell for one portless federation run. Do not commit a filled file.
# BETTER_AUTH_SECRET is required: Void's dev fallback applies only on localhost and 127.0.0.1.
# Generate a local value with: openssl rand -base64 32
NO_PROXY=localhost,.localhost,127.0.0.1
BETTER_AUTH_SECRET=
NODE_EXTRA_CA_CERTS=${HOME}/.portless/ca.pem
E2E_A_ORIGIN=https://a.tstodon.localhost
E2E_B_ORIGIN=https://b.tstodon.localhost
E2E_A_DOMAIN=a.tstodon.localhost
E2E_B_DOMAIN=b.tstodon.localhost
