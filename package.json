{
  "name": "tstodon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "types:worker": "wrangler types --env-interface Env",
    "prisma:pull": "./packages/worker/node_modules/.bin/prisma db pull",
    "prisma:generate": "./packages/worker/node_modules/.bin/prisma generate --sql",
    "e2e:federation": "node e2e/federation-smoke.mjs",
    "e2e:federation:follow-create": "node e2e/federation-follow-create.mjs",
    "e2e:federation:interactions": "node e2e/federation-interactions.mjs",
    "e2e:federation:delete-shared-inbox": "node e2e/federation-delete-shared-inbox.mjs",
    "e2e:federation:accept": "node e2e/federation-accept.mjs",
    "e2e:federation:all": "node e2e/federation-smoke.mjs && node e2e/federation-follow-create.mjs && node e2e/federation-interactions.mjs && node e2e/federation-delete-shared-inbox.mjs && node e2e/federation-accept.mjs",
    "e2e:up": "process-compose up",
    "ci": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^24.13.6",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2"
}
