account_id = "00000000000000000000000000000000"

# --- Worker data plane (D1 / R2 / Queue) ---
create_d1    = true
create_r2    = true
create_queue = true

d1_database_name         = "tstodon"
d1_primary_location_hint = "apac" # matches wrangler placement aws:ap-southeast-1

r2_media_bucket_name = "tstodon-media"
outbox_queue_name    = "tstodon-outbox-process"
outbox_dlq_name      = "tstodon-outbox-dlq"

worker_script_name     = "tstodon"
attach_queue_consumer  = false # set true after the first wrangler deploy

# --- Hostnames ---
instance_hostname = "social.example.com" # INSTANCE_PUBLIC_ORIGIN without https://
zone_id           = "00000000000000000000000000000000"

# --- Media hostname (R2 custom domain + CORS); empty = media from the Worker origin ---
media_hostname = "media.example.com"
# media_cors_allowed_origins = ["https://social.example.com"]

# --- Cloudflare Access (needs a Zero Trust organization) ---
create_access = false
# access_allow_everyone        = false
# access_allowed_emails        = ["you@example.com"]
# access_allowed_email_domains = ["example.com"]
# access_allowed_idps          = [] # identity provider ids; one = no picker
# access_session_duration      = "24h"
