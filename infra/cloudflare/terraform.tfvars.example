account_id = "00000000000000000000000000000000"

# --- Worker data plane (D1 / KV / R2 / Queue) ---
create_d1    = true
create_kv    = true
create_r2    = true
create_queue = true

d1_database_name         = "tstodon"
d1_primary_location_hint = "apac" # matches wrangler placement aws:ap-southeast-1

kv_remote_dns_cache_title = "tstodon-remote-dns-cache"
kv_app_cache_title        = "tstodon-app-cache"
r2_media_bucket_name      = "tstodon-media"
outbox_queue_name         = "tstodon-outbox-process"

worker_script_name     = "tstodon"
attach_queue_consumer  = false # set true after the first wrangler deploy

# --- Cloudflare Access (WorkOS IdP) ---
enable_access = true
zone_id       = "00000000000000000000000000000000" # optional; null uses account-scoped apps
hostname      = "social.example.com"
team_domain   = "https://myteam.cloudflareaccess.com"

admin_groups          = ["tstodon-admins"]
allowed_email_domains = ["example.com"] # empty => any authenticated WorkOS user
session_duration      = "24h"

create_workos_idp = true
# existing_idp_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

workos_oidc = {
  client_id     = "client_..."
  client_secret = "sk_..."
  auth_url      = "https://api.workos.com/user_management/authorize"
  token_url     = "https://api.workos.com/user_management/authenticate"
  certs_url     = "https://api.workos.com/sso/jwks/client_..."
  scopes        = ["openid", "email", "profile"]
  claims        = ["groups", "email"]
  pkce_enabled  = true
}
